set -e
premake5 gmake
make config=debug

cp ./Saffron/src/Renderer/Shaders/Vert.shader ./bin/Debug-linux-x86_64/Sandbox/
cp ./Saffron/src/Renderer/Shaders/Frag.shader ./bin/Debug-linux-x86_64/Sandbox/

pushd ./bin/Debug-linux-x86_64/Sandbox/

mkdir -p res/sys
cp ../../../sys_res/icon_default.png ./res/sys
mv ./Frag.shader ./res/sys
mv ./Vert.shader ./res/sys

./Sandbox 
popd